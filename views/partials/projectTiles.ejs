<div class="" >
    <h2 class="text-5xl text-emerald-800 font-bold pl-4 text-shadow-md">Projects</h2>
    <div class="flex overflow-x-auto">
        <% openProjects.forEach(project => { %>
            <div class="w-60 h-90  bg-slate-200 m-4 justify-items-center rounded-3xl shadow-lg">
                <div class="w-60 h-60 bg-emerald-200 rounded-t-3xl"></div>
                <div class="text-emerald-800 justify-items-center">
                    <h3><%= project.title %></h3>
                <span class="block"><%= project.progress %>% complete</span>
                </div>
                <div class="flex items-center justify-center">
                    <a href="/project/<%= project._id %>" class="block h-10 bg-emerald-700 w-60  rounded-b-3xl text-center flex justify-center items-center text-lg text-white">See Project</a>
                </div>
                
            </div>
        <% }) %>
    </div>
    
</div>