<div>
    
    <div class="flex flex-wrap ">
        <!-- Add Pattern -->
            <div class="w-80 h-80  bg-emerald-700 border-5 border-slate-200 m-4 justify-items-center rounded-3xl">
                <button id="addPattern" class="bg-emerald-700 hover:bg-orange-700 text-emerald-200 font-bold w-80 h-80 py-4 px-4 rounded-3xl text-9xl">+</button>
            </div>
    <% patterns.forEach(pattern => { %>
        <div class="w-80 h-80  bg-emerald-200 m-4 justify-items-center rounded-3xl relative">
            <a href="/pattern/<%= pattern._id%>">
                <div>
                <div class="w-80 h-40 bg-orange-200 rounded-t-3xl"></div>
                <!-- <img src="/images/" alt="cat image"> -->
                <div class="p-4">
                    <h3 class="text-x1"><%= pattern.title %></h3>
                    <p class="text-base">
                    By: <%= pattern.writer %> <br>
                    Colors: <%= pattern.numOfColors %> <br>
                    </p>
                </div>
            </div>
            </a>
            <div class="absolute bottom-0">
                <a href="/project/add/<%= pattern._id %>" class="block h-10 bg-orange-700 w-80 text-center text-lg rounded-b-3xl">Make it</a>
            </div>
        </div>
    <% }) %>
    </div>
</div>