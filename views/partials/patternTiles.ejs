<div>
    <h2>Patterns</h2>
    <div class="flex flex-wrap ">
    <% patterns.forEach(pattern => { %>
        <div class="w-80 h-80  bg-emerald-200 m-4 justify-items-center rounded-3xl">
            <div>
                <div class="w-80 h-40 bg-orange-200 rounded-t-3xl"></div>
                <!-- <img src="/images/" alt="cat image"> -->
                <div class="p-4">
                    <h3 class="text-x1"><%= pattern.title %></h3>
                    <p class="text-base">
                    By: <%= pattern.writer %> <br>
                    Colors: <%= pattern.numOfColors %> <br>
                    </p>
                </div>
            </div>
            <div class="flex flex-col items-center">
                <a href="/pattern/<%= pattern._id%>" class="block ">See More</a>
                <a href="/project/add/<%= pattern._id %>" class="block h-10 bg-orange-700 w-80 text-center text-lg rounded-b-3xl">Make it</a>
            </div>
        </div>
    <% }) %>
    </div>
</div>