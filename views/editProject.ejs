<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-emerald-950">
    <%- include('partials/navbar') %>

    <div class="bg-white w-3/5 m-auto mt-6 rounded-3xl">
        <div class="bg-orange-700 h-20 rounded-t-3xl flex justify-center items-center relative">
            <h1 class="text-3xl text-white text-center" id="currentName"><%= project.title %></h1>
            <form action="/project/edit/<%= project._id %>" method="POST" class="hidden flex gap-4" id="nameEditForm">
                <input type="text" value="<%= project.title %>" name="title" class="p-3 h-full">
                <button type="submit" class="w-20 h-10 rounded-full grid place-items-center bg-lime-300">Save</button>
            </form>
            <span class="absolute top-3 right-3 w-20 h-10 rounded-full grid place-items-center bg-lime-300 cursor-pointer" id="editProjectName">Edit Name</span>
        </div>
        <div class="flex flex-col">
            <% project.colors.forEach(color => { %>
                        <div class="grid grid-cols-5  h-20 m-5 shadow-lg rounded-lg  items-center">
                            <div class="w-20 h-20 rounded-l-lg bg-[<%= color.primaryColorCode %>] col-start-1"></div>
                            <div class="flex flex-col col-start2">
                                <span class="text-lg text-emerald-700"><%= color.colorName %></span>
                                <span class="text-md text-emerald-800 uppercase"><%= color.yarnCollection %></span>
                            </div>
                            <div class="col-start-3 place-items-center content-center text-center">
                                <span>Start</span>
                            </div>
                            <div class="col-start-4 place-items-center content-center text-center">
                                End
                            </div>
                            <div class="col-start-5 place-items-center content-center">
            <form action="/project/deleteColor/<%= project._id%>/<%= color.yarnId %>" method="POST">
                <button type="submit" class="w-20 h-10  mr-10 rounded-full grid place-items-center bg-orange-700">Delete</button>
            </form>
        </div>
                        </div>
                   <% }) %>
                   <div class="grid grid-cols-5  h-20 m-5 shadow-lg rounded-lg"> 
                    <span class="col-start-3">Add Yarn</span>
                   </div>
        </div>
        <div>
            <% project.parts.forEach((part,index) => { %>
                <div class="flex  h-30 m-5 shadow-lg rounded-lg p-5">
                    <h3><%=part.part%></h3>
                    <div class="flex">
                        <% for(let i = 1; i <= part.quantity; i++) { %>
                        <% if(i <= part.quantityCompleted) { %>
                            <div class="px-3 py-2 w-20 h-20 rounded-full bg-emerald-700 text-white text-4xl flex items-center justify-center">
                                <span >&check;</span>
                            </div>
                        <%}else{ %>
                            <div class="px-3 py-2 bg-transparent text-emerald-700 border-2 border-emerald-700 rounded-full w-20 h-20 text-4xl flex items-center justify-center">
                        <span>&check;</span>
                    </div>
                        <% } %>
                   <% }%>
                   <div class="px-3 py-2 w-20 h-20 rounded-full bg-orange-700 text-white text-4xl flex items-center justify-center">&check;</div>
                    </div>
                    
                </div>
            <% }) %>
        </div>
        <div class="flex items-center justify-center m-4">
            <form action="/project/complete/<%= project._id %>" method="POST">
                <button type="submit" class="h-10 w-60 rounded-full bg-orange-700 text-white flex items-center justify-center"> Mark Project Complete</button>
            </form>
        </div>
        <div class="flex items-center justify-center m-4">
            <a href="/project/<%= project._id %>" class="h-10 w-60 rounded-full bg-lime-300 text-emerald-700 flex items-center justify-center">Back to Project</a>
        </div>
        
    </div>
    
    <div>
                
                <form action="/project/addYarn/<%= project._id %>" method="POST" >
                    <!-- <div>
                        <label for="title">Name</label>
                        <input type="text" id="title" name="title" value="PATTERNTITLE" required>
                    </div>   -->
                    <div>  
                        <label for="yarn">Add Yarn</label>
                        <select name="brand" id="brandName">
                            <option value="brand" selected disabled>Brand</option>
                            <option value="bernat">Bernat</option>
                            <option value="bigTwist">Big Twist</option>
                            <option value="premier">Premier</option>
                        </select>
                        <input type="text" placeholder="collection" id="collection" name="collection">
                        <input type="text" placeholder="color name" id="colorName" name="colorName">
                        <input type="color" name="colorCode" id="colorCode">
                    </div>
                    <button type="submit">Add</button>
                </form>
                
            </div>
            <script src="/editProject.js"></script>
</body>
</html>