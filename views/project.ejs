<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= project.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        #counterNum::-webkit-outer-spin-button,
        #counterNum::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        #counterNum {
            -moz-appearance: textfield;
        }
    </style>
</head>
<body class="bg-emerald-950">
    <%- include('partials/navbar') %>

<div class="grid grid-flow-col grid-cols-3 gap-4 bg-emerald-300">
    <div class="col-start-1">
        <h2><%= project.title  %></h2>
        <h4>By: <%= pattern.writer  %></h4>
        <span><%= project.progress %>% Complete</span>
    </div>
    <div class="col-start-1">
        <p>Colors:</p>
        <div class="flex justify-evenly ">
            <% project.colors.forEach(color => { %>
                <% if(color.colorName === "") { %>
                    <a href="/project/edit/<%= project._id%>">
                    <div class="grid place-items-center w-20 h-20 rounded-full bg-emerald-700 ">
                        <span class="text-3xl text-emerald-200">+</span> 
                    </div>
                </a>
                <% }else { %>
                     <div class="flex flex-col">
                <div class="w-20 h-20 rounded-full bg-[<%= color.colorCode %>]"></div>
                <h3 class="text-center text-2xl"><%= color.colorName %></h3>
                <span class="text-center text-base"><%=color.brand  %></span>
            </div>
                <% } %>
            <%}) %>
            <% if(pattern.numOfColors > project.colors.length) { %>
                <a href="/project/edit/<%= project._id%>">
                    <div class="grid place-items-center w-20 h-20 rounded-full bg-emerald-700 ">
                        <span class="text-3xl text-emerald-200">+</span> 
                    </div>
                </a>
            <%} %>
        </div>
    </div>
    
    <% project.parts.forEach((part,index) => { %>
        <% if(part.complete) {%>
            <div class="col-start-1 bg-lime-300  h-30 rounded-full">
                <h4 class="text-center text-5xl"><%= part.part  %></h4>
            </div>
        <% }else if(part.active){ %>
            <div class="col-start-1 bg-orange-300 h-30 rounded-x1">
                <h4 class="text-center text-5xl"><%= part.part  %></h4>
            </div>
        <% }else { %>
            <div class="col-start-1 bg-emerald-700 h-30 rounded-full">
                <div class="flex justify-center">
                <form method="POST" action="/project/part/<%= project._id %>/<%= index %>" class="inline  w-full h-full rounded-full">
                        <button type="Submit" class="text-center text-5xl w-full h-full rounded-full"><%= part.part  %></button>
            </form>
                </div>
                
            </div>
        <% } %>
    <% }) %>
    <!-- Counter -->
    <div class="col-start-2 col-span-2">
        <% if(activePart && activePart.quantityCompleted < activePart.quantity) {%>
            <div class="flex items-center gap-2">
                <form method="POST" action="/project/part/rowCount/<%= project._id %>/<%= project.parts.findIndex(p => p.active) %>" id="counter">
                    <div class="flex items-center gap-2">
                        <button type="button" id="decrement-btn" class="px-3 py-2 bg-orange-700 text-white rounded-full">−</button>
                        <input type="number" id="counterNum" name="counterNum" max="<%= activePart.rows %>" min="0" value="<%= activePart.currentRow %>" class="w-16 text-center bg-transparent border-0">
                        <button type="button" id="increment-btn" class="px-3 py-2 bg-orange-700 text-white rounded-full">+</button>
                        <button type="submit" class=" blockpx-4 py-2 bg-emerald-700 text-white rounded-full">Save</button>
                    </div>
                </form>
            </div>
        <% } %>
        <div id="finishPart" class="hidden">
            <form action="/project/finishPart/<%= project._id %>/<%= activePartIndex %>" method="POST">
                <button type="submit">Done</button>
            </form>
        </div>
        


    </div>
    <div class="col-start-2 col-span-2">
        <% if(activePart) { %>
            <h2><%= activePart.part %></h2>
        Completed <%=activePart.quantityCompleted  %> of <%=activePart.quantity  %>
        <% }%>
         
    </div>
    <div class="col-start-2 col-span-2">Progress</div>
    <div class="col-start-2 col-span-2">Timer</div>


</div>

    <div>
        <a href="/project/edit/<%= project._id%>">Edit</a>
        <form action="/project/delete/<%= project._id%>" method="POST">
                <button type="submit">Delete</button>
            </form>
    </div>
    
    
    
    <script src="/counter.js"></script>
</body>
</html>